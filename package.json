{
  "name": "smartcal",
  "version": "1.0.14",
  "type": "module",
  "description": "Ultra-high-performance mathematical expression engine with JIT compilation (~2.5M+ ops/s), CSP-safe VM mode, Pratt parser, and zero dependencies. Evaluate dynamic formulas safely without eval().",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "./dist",
    "./LICENCE",
    "./README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nXhermane/smartcal.git"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench",
    "bench:save": "vitest bench --outputJson=bench/results/current.json && bun run bench:docs",
    "bench:docs": "bun run scripts/generate-bench-docs.ts",
    "bench:baseline": "vitest bench --outputJson=bench/results/baseline.json",
     "bench:compare": "vitest bench --compare=bench/results/baseline.json",
    "examples": "bun run examples.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check-types": "tsc --noEmit",
    "prepare": "husky"
  },
  "keywords": [
    "expression-engine",
    "expression-evaluator",
    "math-parser",
    "formula-engine",
    "jit-compiler",
    "csp-safe",
    "no-eval",
    "mathematical-expressions",
    "pratt-parser",
    "typescript",
    "zero-dependencies",
    "formula-calculator",
    "safe-eval"
  ],
  "author": "nXhermane",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "mermaid": "^11.17.2",
    "tinybench": "^6.1.4",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": ["biome check --write --no-errors-on-unmatched"]
  }
}
